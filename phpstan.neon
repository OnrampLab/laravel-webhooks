includes:
  - ./vendor/larastan/larastan/extension.neon
  # Pre-existing errors at the larastan 3 upgrade; shrink this, don't grow it.
  - ./phpstan-baseline.neon
parameters:

    paths:
        - src

    # The level 8 is the highest level
    level: 8

    ignoreErrors:
        - identifier: missingType.iterableValue

    excludePaths:
        - ./*/*/tests/*.php
        - ./*/*/factories/*.php
        - ./*/*/migrations/*.php

    databaseMigrationsPath:
        - ./database/migrations

